CC = gcc
CFLAGS = -Wall -Wextra -O3 -march=native -ffast-math -fopenmp
LDLIBS = -lm

TARGET = bin/mandelbrot_openmp

BUILD_DIR = build/openmp
OBJS = $(BUILD_DIR)/main_openmp.o $(BUILD_DIR)/mandelbrot.o
OUTPUT_DIR = output
T ?= 4

.PHONY: all run clean

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJS) $(LDLIBS)

$(BUILD_DIR)/main_openmp.o: src/main_openmp.c include/mandelbrot.h
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -Iinclude -c $< -o $@

$(BUILD_DIR)/mandelbrot.o: src/mandelbrot.c include/mandelbrot.h
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -Iinclude -c $< -o $@

ARGS ?=

run: $(TARGET)
	@mkdir -p $(OUTPUT_DIR)
	./$(TARGET) $(T) $(ARGS)
	@mv -f mandelbrot_openmp.bin mandelbrot_openmp.ppm $(OUTPUT_DIR)/
	@echo "Arquivos de saída salvos em $(OUTPUT_DIR)/"

run-seahorse: $(TARGET)
	@mkdir -p $(OUTPUT_DIR)
	./$(TARGET) $(T) --seahorse $(ARGS)
	@mv -f mandelbrot_openmp.bin mandelbrot_openmp.ppm $(OUTPUT_DIR)/
	@echo "Arquivos de saída salvos em $(OUTPUT_DIR)/"

clean:
	rm -rf $(BUILD_DIR) $(TARGET)
	rm -f $(OUTPUT_DIR)/mandelbrot_openmp.bin $(OUTPUT_DIR)/mandelbrot_openmp.ppm mandelbrot_openmp.bin mandelbrot_openmp.ppm
