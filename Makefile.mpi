export MPICH_CC ?= gcc

MPICC ?= mpicc
MPIEXEC ?= mpirun
CFLAGS = -Wall -Wextra -O3 -march=native -ffast-math
LDLIBS = -lm

TARGET = bin/mandelbrot_mpi

BUILD_DIR = build/mpi
OBJS = $(BUILD_DIR)/main_mpi.o $(BUILD_DIR)/mandelbrot.o
OUTPUT_DIR = output
NP ?= 4

.PHONY: all run run-seahorse check clean

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p $(@D)
	$(MPICC) $(CFLAGS) -o $(TARGET) $(OBJS) $(LDLIBS)

$(BUILD_DIR)/main_mpi.o: src/main_mpi.c include/mandelbrot.h
	@mkdir -p $(@D)
	$(MPICC) $(CFLAGS) -Iinclude -c $< -o $@

$(BUILD_DIR)/mandelbrot.o: src/mandelbrot.c include/mandelbrot.h
	@mkdir -p $(@D)
	$(MPICC) $(CFLAGS) -Iinclude -c $< -o $@

ARGS ?=

run: $(TARGET)
	@mkdir -p $(OUTPUT_DIR)
	$(MPIEXEC) -np $(NP) ./$(TARGET) $(ARGS)
	@mv -f mandelbrot_mpi.bin mandelbrot_mpi.ppm $(OUTPUT_DIR)/
	@echo "Arquivos de saída salvos em $(OUTPUT_DIR)/"

run-seahorse: $(TARGET)
	@mkdir -p $(OUTPUT_DIR)
	$(MPIEXEC) -np $(NP) ./$(TARGET) --seahorse $(ARGS)
	@mv -f mandelbrot_mpi.bin mandelbrot_mpi.ppm $(OUTPUT_DIR)/
	@echo "Arquivos de saída salvos em $(OUTPUT_DIR)/"

check: $(TARGET)
	@NP=$(NP) ./scripts/verify_mpi.sh $(ARGS)

clean:
	rm -rf $(BUILD_DIR) $(TARGET)
	rm -f $(OUTPUT_DIR)/mandelbrot_mpi.bin $(OUTPUT_DIR)/mandelbrot_mpi.ppm mandelbrot_mpi.bin mandelbrot_mpi.ppm
