CC = gcc
CFLAGS = -Wall -Wextra -O3 -march=native -ffast-math -fopenmp
LDLIBS = -lm

TARGET = bin/mandelbrot_seq

BUILD_DIR = build/seq
OBJS = $(BUILD_DIR)/main.o $(BUILD_DIR)/mandelbrot.o
OUTPUT_DIR = output

.PHONY: all run run-seahorse check clean

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJS) $(LDLIBS)

$(BUILD_DIR)/main.o: src/main.c include/mandelbrot.h
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -Iinclude -c $< -o $@

$(BUILD_DIR)/mandelbrot.o: src/mandelbrot.c include/mandelbrot.h
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -Iinclude -c $< -o $@

ARGS ?=

run: $(TARGET)
	@mkdir -p $(OUTPUT_DIR)
	./$(TARGET) $(ARGS)
	@mv -f mandelbrot.bin mandelbrot.ppm $(OUTPUT_DIR)/
	@echo "Arquivos de saída salvos em $(OUTPUT_DIR)/"

run-seahorse: $(TARGET)
	@mkdir -p $(OUTPUT_DIR)
	./$(TARGET) --seahorse $(ARGS)
	@mv -f mandelbrot.bin mandelbrot.ppm $(OUTPUT_DIR)/
	@echo "Arquivos de saída salvos em $(OUTPUT_DIR)/"

check: $(TARGET)
	@$(MAKE) -f Makefile.openmp all
	@THREADS=$(T) ./scripts/verify_correctness.sh $(ARGS)

clean:
	rm -rf $(BUILD_DIR) $(TARGET)
	rm -f $(OUTPUT_DIR)/mandelbrot.bin $(OUTPUT_DIR)/mandelbrot.ppm mandelbrot.bin mandelbrot.ppm
